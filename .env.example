# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================
# TRAKT API CREDENTIALS
# ============================
# Create an app at https://developer.trakt.tv/apps
CLIENT_ID=your_trakt_client_id_here
ACCESS_TOKEN=your_trakt_access_token_here
REFRESH_TOKEN=your_trakt_refresh_token_here

# ============================
# OPTIONAL CONFIGURATION
# ============================

# Include Netflix Kids content lists (True/False)
# Note: Trakt limits users to 10 lists, so consider using a separate account for kids lists
KIDS_LIST=False

# Print scraped lists to console for debugging (True/False)
PRINT_LISTS=False

# BuzzKee shared FlixPatrol rendering service
BUZZKEE_URL=http://127.0.0.1:8000
BUZZKEE_API_KEY=your_buzzkee_api_key
BUZZKEE_REQUEST_TIMEOUT=60

# ============================
# SETUP INSTRUCTIONS
# ============================
# 1. Create a Trakt app at https://developer.trakt.tv/apps
# 2. Set CLIENT_ID, then run: python authorize_trakt.py
# 3. Approve the displayed device code; the script saves access and refresh tokens
# 4. Update CLIENT_ID, ACCESS_TOKEN, and REFRESH_TOKEN in GitHub Actions secrets
# 5. Add GH_PAT so scheduled runs can rotate the single-use refresh token
#
# For detailed instructions, see SETUP.md
